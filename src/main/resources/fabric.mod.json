{
	"schemaVersion": 1,
	"id": "misiones",
	"version": "${version}",
	"name": "Misiones Diarias",
	"description": "3 misiones nuevas cada dia y un desafio semanal (minar, cazar, fabricar, pescar, entregar, explorar...) que pagan fichas. Tecla J.",
	"authors": [
		"chefsitturchey"
	],
	"license": "CC0-1.0",
	"icon": "assets/misiones/icon.png",
	"environment": "*",
