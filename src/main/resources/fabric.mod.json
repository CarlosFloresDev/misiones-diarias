		"main": [
			"com.aventura.misiones.MisionesMod"
		],
		"client": [
			"com.aventura.misiones.client.MisionesClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"arequipa": "*",
		"tecsup": "*",
		"cielo": "*"
	},
	"mixins": [
		{
			"config": "misiones.client.mixins.json",
			"environment": "client"
		}
	]
